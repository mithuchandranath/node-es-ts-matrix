---
import MatrixTable from "../components/MatrixTable.tsx";
import matrix from "../data/matrix.json";
import type { MatrixData } from "../types";
import "../styles/global.css";

const data = matrix as MatrixData;
const generated = new Date(data.generatedAt).toUTCString();
const { typescript: tsNext } = data.nextReleases;
const { ecmascript: esUp, typescript: tsUp, node: nodeUp } = data.upcoming;
const npmTsUrl = (v: string) =>
  `https://www.npmjs.com/package/typescript/v/${v}`;
const upcomingTsChannels: Array<{
  label: string;
  version: string;
  url: string;
}> = [
  tsUp.next && { label: "next (nightly)", version: tsUp.next, url: npmTsUrl(tsUp.next) },
  tsUp.rc && { label: "rc", version: tsUp.rc, url: npmTsUrl(tsUp.rc) },
  tsUp.beta && { label: "beta", version: tsUp.beta, url: npmTsUrl(tsUp.beta) },
].filter((x): x is { label: string; version: string; url: string } => Boolean(x));

const title =
  "Node.js ↔ ECMAScript ↔ TypeScript Compatibility Matrix";
const description =
  "For every Node.js LTS, the recommended ECMAScript target and the minimum TypeScript version that supports it — refreshed weekly from tsconfig/bases, nodejs/Release, microsoft/TypeScript, and tc39/proposals.";
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("favicon.svg", canonical).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: title,
  description,
  url: canonical,
  license: "https://opensource.org/license/mit",
  keywords: [
    "Node.js",
    "TypeScript",
    "ECMAScript",
    "tsconfig",
    "compatibility matrix",
    "LTS",
  ],
  isAccessibleForFree: true,
  dateModified: data.generatedAt,
  creator: { "@type": "Person", name: "mithuchandranath" },
  distribution: {
    "@type": "DataDownload",
    encodingFormat: "application/json",
    contentUrl: new URL("matrix.json", canonical).toString(),
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="theme-color" content="#0f172a" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Node ↔ ES ↔ TS Matrix" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://www.typescriptlang.org" />
    <link rel="preconnect" href="https://nodejs.org" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <main class="page">
      <h1>Node ↔ ECMAScript ↔ TypeScript matrix</h1>
      <p class="subtitle">
        For each Node.js major, the ECMAScript target recommended by
        <code>@tsconfig/bases</code> and the minimum TypeScript compiler version
        that accepts that target. Use it to pick a matching{" "}
        <code>tsconfig.json</code> for your runtime.
      </p>

      <aside class="tips">
        <strong>Upgrade strategy — Node → ES → TS, in that order:</strong>
        <ol>
          <li>Pick a stable Node.js <strong>LTS</strong> version.</li>
          <li>
            Look up the ECMAScript target it supports natively (e.g. Node 22 →
            <code>ES2024</code>).
          </li>
          <li>
            Upgrade TypeScript <em>last</em> to a release that accepts that
            target, then set <code>compilerOptions.target</code> to it.
          </li>
        </ol>
      </aside>

      <MatrixTable client:load data={data} />

      <section class="news" aria-labelledby="news-heading">
        <h2 id="news-heading">What's next in the JS ecosystem</h2>
        <p class="news-lead">
          Live signals from TC39, Microsoft/TypeScript, and Node.js so you know
          what's landing before it hits your <code>tsconfig.json</code>.
        </p>

        <div class="news-grid">
          <article class="news-card">
            <h3>
              <span class="news-tag news-tag-es">ECMAScript</span>
              Stage 3 candidates
            </h3>
            <p class="news-card-lead">
              Spec complete, awaiting implementer feedback. Likely to reach
              Stage 4 (finished) in an upcoming yearly edition.
            </p>
            {esUp.stage3.length > 0 ? (
              <details class="news-details">
                <summary>
                  {esUp.stage3.length} proposal
                  {esUp.stage3.length === 1 ? "" : "s"} at Stage 3
                </summary>
                <ul class="news-list">
                  {esUp.stage3.map((p) => (
                    <li>
                      <a href={p.url} target="_blank" rel="noreferrer">
                        {p.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <p class="news-empty">No Stage 3 proposals resolved.</p>
            )}
            {esUp.finishedByYear.length > 0 && (
              <div class="news-sub">
                <strong>Finished, awaiting publication:</strong>
                <ul class="news-list">
                  {esUp.finishedByYear.map((y) => (
                    <li>
                      <strong>ES{y.year}</strong> — {y.proposals.length}{" "}
                      finished proposal
                      {y.proposals.length === 1 ? "" : "s"}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            <p class="news-links">
              <a href={esUp.proposalsUrl} target="_blank" rel="noreferrer">
                tc39/proposals
              </a>{" · "}
              <a href={esUp.processDocumentUrl} target="_blank" rel="noreferrer">
                process
              </a>{" · "}
              <a href={esUp.specDraftUrl} target="_blank" rel="noreferrer">
                spec draft
              </a>
            </p>
          </article>

          <article class="news-card">
            <h3>
              <span class="news-tag news-tag-ts">TypeScript</span>
              Pre-releases &amp; roadmap
            </h3>
            <p class="news-card-lead">
              Latest stable on npm:{" "}
              <a
                href={npmTsUrl(tsUp.latest ?? "latest")}
                target="_blank"
                rel="noreferrer"
              >
                <code>{tsUp.latest ?? "unknown"}</code>
              </a>
              .
            </p>
            {upcomingTsChannels.length > 0 && (
              <ul class="news-list">
                {upcomingTsChannels.map((t) => (
                  <li>
                    <strong>{t.label}:</strong>{" "}
                    <a href={t.url} target="_blank" rel="noreferrer">
                      <code>{t.version}</code>
                    </a>
                  </li>
                ))}
              </ul>
            )}
            <p class="news-links">
              <a href={tsUp.roadmapUrl} target="_blank" rel="noreferrer">
                roadmap
              </a>{" · "}
              <a href={tsUp.iterationPlansUrl} target="_blank" rel="noreferrer">
                iteration plans
              </a>{" · "}
              <a href={tsUp.releasesUrl} target="_blank" rel="noreferrer">
                releases
              </a>{" · "}
              <a href={tsUp.devBlogUrl} target="_blank" rel="noreferrer">
                dev blog
              </a>
            </p>
          </article>

          <article class="news-card">
            <h3>
              <span class="news-tag news-tag-node">Node.js</span>
              Upcoming majors
            </h3>
            {nodeUp.upcomingMajors.length > 0 ? (
              <ul class="news-list">
                {nodeUp.upcomingMajors.map((n) => (
                  <li>
                    <strong>Node {n.major}</strong>
                    {n.codename ? ` (${n.codename})` : ""}
                    {n.ltsStart ? <> — LTS <code>{n.ltsStart}</code></> : null}
                    {" · "}EOL <code>{n.eol}</code>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="news-empty">
                No future majors scheduled yet — check the release schedule for
                updates.
              </p>
            )}
            <p class="news-links">
              <a href={nodeUp.scheduleUrl} target="_blank" rel="noreferrer">
                release schedule
              </a>{" · "}
              <a href={nodeUp.releasesUrl} target="_blank" rel="noreferrer">
                previous releases
              </a>{" · "}
              <a href={nodeUp.changelogUrl} target="_blank" rel="noreferrer">
                CHANGELOG
              </a>{" · "}
              <a href={nodeUp.blogUrl} target="_blank" rel="noreferrer">
                blog
              </a>
            </p>
          </article>
        </div>
      </section>

      <p class="generated">
        Data generated: {generated} · TypeScript latest on npm:{" "}
        <code>{tsNext.latest ?? "unknown"}</code>
      </p>

      <p class="sources">
        Sources:{" "}
        <a href={data.sources.tsconfigBases}>@tsconfig/bases</a>,{" "}
        <a href={data.sources.nodeSchedule}>nodejs/Release schedule.json</a>,{" "}
        <a href={data.sources.typescriptRepo}>microsoft/TypeScript</a> git tags
        (live min-TS resolution),{" "}
        <a href={data.sources.typescriptRegistry}>npm registry</a> (dist-tags),
        and{" "}
        <a href={data.sources.tc39Proposals}>tc39/proposals</a> finished list.
      </p>
    </main>
  </body>
</html>
